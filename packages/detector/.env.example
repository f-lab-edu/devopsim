# detector 로컬 실행용 환경 변수 템플릿.
# .env로 복사 후 값 채우기. .env는 gitignore라 추적 안 됨.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   uv run python -m detector.main

# --- Anthropic API (필수) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- LLM 모델 (선택, 기본 claude-sonnet-4-6) ----------------------------------
DETECTOR_MODEL=claude-sonnet-4-6

# --- 외부 시스템 URL (in-cluster 기본값. 로컬은 port-forward 또는 fake) ------
# 로컬에서 실 클러스터 호출하려면 port-forward 필요:
#   kubectl port-forward -n monitoring svc/kube-prometheus-stack-prometheus 9090:9090
#   kubectl port-forward -n monitoring svc/loki 3100:3100
#   kubectl port-forward -n monitoring svc/kube-prometheus-stack-alertmanager 9093:9093
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093

# --- Slack 결과 통지 (선택) ---------------------------------------------------
SLACK_WEBHOOK_URL=

# --- 안전장치 -----------------------------------------------------------------
ALLOWED_NAMESPACES=api
MAX_STEPS=10
DRY_RUN=false
